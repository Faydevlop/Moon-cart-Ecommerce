<div class="tab-pane table-dashboard dashboard wish-list-section" id="order">
    <div class="box-head mb-3">
        <h3>Your Orders</h3>
    </div>
    <div class="table-responsive">
        <% if (orders.length > 0) { %>
            <% orders.forEach(order => { %>
                <div class="order-container mb-4">
                    <div class="order-header p-3"> <div class="row align-items-center w-100"> <div class="col-md-4">
                                <h5 class="mb-0">Order #<%= order.order_id %></h5>
                                <small>Date: <%= new Date(order.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %></small>
                            </div>
                            <div class="col-md-4 text-md-center order-status">
                                <% if (order.status === 'Pending') { %>
                                    <span class="badge bg-warning text-dark">Pending</span>
                                <% } else if (order.status === 'Shipped') { %>
                                    <span class="badge bg-info">Shipped</span>
                                <% } else if (order.status === 'Cancelled') { %>
                                    <span class="badge bg-danger">Canceled</span>
                                <% } else if (order.status === 'Delivered') { %>
                                    <span class="badge bg-success">Delivered</span>
                                <% } else if (order.status === 'returned') { %>
                                    <span class="badge bg-secondary">Returned</span>
                                <% } else { %>
                                    <span class="badge bg-secondary">Status not available</span>
                                <% } %>
                            </div>
                            <div class="col-md-4 text-md-end">
                                <% if(order.status === 'Delivered') { %>
                                    <% if (order.products && order.products.length > 1 && !order.products.every(p => p.status === 'returned')) { %>
                                        <a href="javascript:void(0)" class="btn btn-sm btn-danger me-2" onclick="returnAllOrder('<%= order._id %>')">Return All Order</a>
                                    <% } %>
                                    <a href="/invoice/<%= order._id %>" class="btn btn-sm btn-secondary">View Invoice</a>
                                <% } else if(order.status === 'returned') { %>
                                    <span class="badge bg-secondary">Returned</span>
                                <% } else if(order.status === 'Cancelled') { %>
                                    <span class="badge bg-secondary">Canceled</span>
                                <% } else { %>
                                    <% if (order.products && order.products.length > 1) { %>
                                        <a href="javascript:void(0)" class="btn btn-sm btn-danger me-2" onclick="cancelAllOrder('<%= order._id %>')">Cancel All Order</a>
                                    <% } %>
                                    <a href="/invoice/<%= order._id %>" class="btn btn-sm btn-secondary">View Invoice</a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    
                    <% if (order.products && order.products.length > 0) { %>
                        <table class="table cart-table">
                            <thead>
                                <tr class="table-head">
                                    <th scope="col">Image</th>
                                    <th scope="col">Product Details</th>
                                    <th scope="col">Price</th>
                                    <th scope="col">Quantity</th>
                                    <th scope="col">Total</th>
                                    <th scope="col">View</th>
                                    <th scope="col">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% order.products.forEach(box => { %>
                                    <% let product = box.product; %>
                                    <tr>
                                        <td>
                                            <a href="/product/<%= product._id %>">
                                                <img src="<%= product.singleImage %>" class="blur-up lazyload" alt="" width="80">
                                            </a>
                                        </td>
                                        <td>
                                            <p class="fs-6 m-0"><%= product.name %></p>
                                        </td>
                                        <td>
                                            <p class="fs-6">₹<%= product.price %></p>
                                        </td>
                                        <td>
                                            <p class="fs-6"><%= box.quantity %></p>
                                        </td>
                                        <td>
                                            <p class="fs-6">₹<%= box.total %></p>
                                        </td>
                                        <td>
                                            <a href="/productorder/<%= product._id %>">
                                                <i class="far fa-eye"></i>
                                            </a>
                                        </td>
                                        <td>
                                            <% if(order.status === 'Delivered' && box.status !== 'returned') { %> <a href="javascript:void(0)">
                                                    <button type="button" class="btn btn-sm btn-danger" onclick="getreturn('<%= order._id %>','<%= product._id %>')">Return</button>
                                                </a>
                                            <% } else if(box.status === 'returned') { %> <button type="button" class="btn btn-sm btn-secondary" disabled>Returned</button>
                                            <% } else if(order.status === 'Cancelled' || box.status === 'cancelled') { %> <button type="button" class="btn btn-sm btn-secondary" disabled>Canceled</button>
                                            <% } else if(order.status !== 'Delivered' && order.status !== 'returned' && order.status !== 'Cancelled') { %>
                                                <a href="javascript:void(0)">
                                                    <button type="button" class="btn btn-sm btn-warning" onclick="getid('<%= order._id %>','<%= product._id %>')">Cancel Product</button>
                                                </a>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                        <div class="order-footer p-3 text-end"> <strong>Grand Total: ₹<%= order.grandTotal %></strong>
                        </div>
                    <% } else { %>
                        <div class="text-center py-3">
                            <p>No products for this order.</p>
                        </div>
                    <% } %>
                </div>
            <% }); %>
        <% } else { %>
            <div class="empty-orders text-center py-5">
                <i class="fas fa-shopping-bag fa-3x mb-3 text-muted"></i>
                <h4>No Orders Available</h4>
                <p class="text-muted">You haven't placed any orders yet or no orders match your filters.</p>
                <a href="/shop" class="btn btn-primary mt-2">Continue Shopping</a>
            </div>
        <% } %>

        <nav aria-label="Order Pagination">
            <ul class="pagination justify-content-center">
                <% if (currentPage > 1) { %>
                    <li class="page-item">
                        <a class="page-link" href="?page=<%= currentPage - 1 %>&search=<%= searchQuery %>&startDate=<%= startDate %>&endDate=<%= endDate %>" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                <% } %>
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= i %>&search=<%= searchQuery %>&startDate=<%= startDate %>&endDate=<%= endDate %>"><%= i %></a>
                    </li>
                <% } %>
                <% if (currentPage < totalPages) { %>
                    <li class="page-item">
                        <a class="page-link" href="?page=<%= currentPage + 1 %>&search=<%= searchQuery %>&startDate=<%= startDate %>&endDate=<%= endDate %>" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                <% } %>
            </ul>
        </nav>
    </div>
</div>

                       
