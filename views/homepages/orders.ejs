<style>
    /* Custom Styles for Order Page */
    .order-container {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        overflow: hidden; /* Ensures borders wrap children correctly */
        box-shadow: 0 2px 5px rgba(0,0,0,0.05); /* Subtle shadow for depth */
        margin-bottom: 2rem; /* More space between order blocks */
    }

    .order-header {
        background-color: #f8f9fa; /* Lighter background for header */
        border-bottom: 1px solid #e0e0e0;
        padding: 1rem 1.5rem; /* More padding */
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .order-header h5 {
        font-weight: 600;
        color: #343a40;
    }

    .order-header small {
        color: #6c757d;
    }

    .order-status .badge {
        padding: 0.5em 0.8em;
        font-size: 0.9em;
        border-radius: 0.25rem;
    }

    .cart-table th, .cart-table td {
        vertical-align: middle; /* Align content vertically in table cells */
        padding: 1rem; /* More padding in table cells */
    }

    .cart-table thead th {
        background-color: #f1f1f1; /* Light background for table header */
        font-weight: 600;
        color: #555;
    }

    .order-footer {
        background-color: #f8f9fa; /* Matches header background */
        border-top: 1px solid #e0e0e0;
        padding: 1rem 1.5rem;
        text-align: right;
    }

    .order-footer strong {
        font-size: 1.25rem;
        color: #212529;
    }

    .empty-orders {
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 3rem;
        margin-top: 2rem;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .empty-orders i {
        color: #6c757d;
    }

    /* Filter form responsiveness */
    @media (max-width: 767.98px) {
        .d-flex.flex-column.flex-md-row {
            align-items: stretch !important; /* Align items to stretch on small screens */
        }
        .d-flex.flex-column.flex-md-row > div {
            width: 100%;
            margin-bottom: 1rem; /* Space between form controls */
        }
        .d-flex.flex-column.flex-md-row button,
        .d-flex.flex-column.flex-md-row a.btn {
            width: 100%; /* Full width buttons on small screens */
        }
    }
</style>

