    <style>
        /* Custom styles for background and centering */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden; /* Prevents scrollbars if content doesn't exceed viewport */
        }

        body {
            background-color: skyblue; /* Set entire page background to sky blue */
            display: flex;
            justify-content: center; /* Center horizontally */
            align-items: center; /* Center vertically */
            min-height: 100vh; /* Ensure body takes full viewport height */
        }

        /* Adjustments for the success icon and text to ensure proper centering */
        .success-icon {
            text-align: center; /* Centers inline-block and text elements */
            display: flex;
            flex-direction: column; /* Stacks children vertically */
            align-items: center; /* Centers children horizontally in a column layout */
            justify-content: center; /* Centers children vertically if space allows */
            height: 100%; /* Take full height of its parent if needed */
        }

        /* Make the tick's background green */
        .check-background {
            background-color: green; /* Green background for the tick circle */
            border-radius: 50%; /* Ensures it's a circle */
            display: inline-flex; /* Use inline-flex to center SVG inside it */
            align-items: center;
            justify-content: center;
            /* You might need to adjust size and padding based on your existing CSS for .check-background */
            width: 100px; /* Example size, adjust as needed */
            height: 100px; /* Example size, adjust as needed */
        }

        .check-background svg {
            width: 60px; /* Adjust SVG size relative to its container */
            height: 60px; /* Adjust SVG size relative to its container */
        }
        
        /* Ensure the white tick remains white on the green background */
        .check-background svg path {
            stroke: white; 
        }

        /* Button styling for better appearance */
        .btn-solid-default {
            background-color: #007bff; /* Example button color */
            color: white;
            padding: 10px 20px;
            border-radius: 5px;
            text-decoration: none;
            margin-top: 20px; /* Space between text and button */
        }

        .btn-solid-default:hover {
            background-color: #0056b3;
        }

        /* Hide mobile menu and other unneeded sections */
        .mobile-menu,
        .tap-to-top,
        .bg-overlay {
            display: none !important;
        }
    </style>

</head>

<body>

    <section class="pt-0">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 p-0">
                    <div class="success-icon">
                        <div class="main-container">
                            <div class="check-container">
                                <div class="check-background">
                                    <svg viewBox="0 0 65 51" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M7 25L27.3077 44L58.5 7" stroke="white" stroke-width="13"
                                            stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </div>
                                <div class="check-shadow"></div>
                            </div>
                        </div>

                        <div class="success-contain">
                            <h4>Order Success!</h4>
                            <h5 class="font-light">Your Order Is On The Way</h5>
                        </div>
                        <div class="text-center mt-4">
                            <a href="/orders" class="btn btn-solid-default">View Your Orders</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
