<script>
	async function addtocart(productId){
		// alert(productId)
		const response = await fetch('/addcart', {
                method: 'post',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ productId })
				
            });

			const data = await response.json();

			if (data && data.message === 'Product added to the cart') {
            Swal.fire({
                icon: 'success',
                title: 'Product added to the cart',
                
            });
			setTimeout(() => {
				location.reload()
				
			}, 1500);
        }else if (data && data.message === 'Please Login To Add Products To cart') {
        // 👉 Show login prompt with redirect button
        Swal.fire({
            icon: 'warning',
            title: 'Login Required',
            text: 'Please login to add products to your cart.',
            confirmButtonText: 'Login',
            showCancelButton: true,
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '/login';
            }
        });
    } else {
        // 🔴 Generic error handler
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: data.message || 'An error occurred while adding the product.',
        });
    }




	}
</script
