					<h3 class="title">Most Popular Category</h3>
					<div class="site-filters clearfix d-flex align-items-center wow fadeInUp" data-wow-delay="0.1s">
						<% if (categorys && categorys.length > 0) { %>
							<ul>
								<% categorys.forEach(categoryData => { %>
									<li class="btn active">
										<input type="radio">
										<a href="/category/<%= categoryData._id %>">
											<%= categoryData.categoryname %> <span><% if (categoryData.categeoryOffers)   {%>
												<%= categoryData.categeoryOffers %>
											<%}%>
											</span>
											
										</a>
									</li>
									
								<% }) %>
							</ul>
						<% } else { %>
							<p>No categories found.</p>
						<% } %>
						
						</ul>
					
									
					</div>
					<hr>
					<div class="clearfix">
						<!-- start -->
	
					<ul id="masonry" class="row g-xl-4 g-3">
