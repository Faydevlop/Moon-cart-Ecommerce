<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    async function toggleWishlist(productId, el) {
        const isActive = el.classList.contains('active');
        const method = isActive ? 'remove' : 'add';
        const url = `/wishlistshort/${method}/${productId}`;

        try {
            const res = await fetch(url, { method: 'POST' });

            // Check if the response is OK (status 200-299)
            if (!res.ok) {
                // If the response is not OK, it might be an HTML page for unauthorized access, etc.
                const text = await res.text(); // Get the raw text of the response
                console.error('Server responded with non-OK status:', res.status, text);

                // Attempt to parse as JSON in case it's a valid JSON error,
                // but fall back to a generic message if it's HTML.
                try {
                    const errorData = JSON.parse(text);
                    if (errorData.redirectTo) {
                        Swal.fire({
                            title: 'Login Required',
                            text: errorData.message || 'Please log in to manage your wishlist.',
                            icon: 'warning',
                            showCancelButton: false,
                            confirmButtonText: 'Login'
                        }).then(() => {
                            window.location.href = errorData.redirectTo;
                        });
                        return; // Stop execution after redirecting
                    }
                    Swal.fire('Error', errorData.message || 'Something went wrong on the server.', 'error');
                } catch (parseError) {
                    // This means the response was not JSON (e.g., HTML)
                    Swal.fire(
                        'Error',
                        'An unexpected error occurred. You might need to log in or something went wrong on the server.',
                        'error'
                    );
                }
                return; // Stop execution if response not OK
            }

            // If response is OK, proceed to parse as JSON
            const data = await res.json();

            if (data.success) {
                if (method === 'add') {
                    el.classList.add('active');
                    Swal.fire('Added!', 'Product added to wishlist', 'success');
                } else {
                    el.classList.remove('active');
                    Swal.fire('Removed!', 'Product removed from wishlist', 'info');
                }
            } else {
                // Server explicitly sent success: false in JSON
                Swal.fire('Error', data.message || 'Something went wrong', 'error');
            }
        } catch (error) {
            // This catch block handles network errors or issues with res.json() if the server returns malformed JSON
            console.error('Fetch or JSON parsing error:', error);
            Swal.fire('Login Required', 'Please Login to add Products to your wishlist', 'error');
        }
    }
</script>

</body>

