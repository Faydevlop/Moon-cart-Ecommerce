    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // --- Product Offer Filter Form Logic ---
        const productOfferFilterForm = document.getElementById('productOfferFilterForm');
        const productSearchInput = productOfferFilterForm.querySelector('input[name="productSearch"]');
        const productStartDateInput = productOfferFilterForm.querySelector('input[name="productStartDate"]');
        const productEndDateInput = productOfferFilterForm.querySelector('input[name="productEndDate"]');
        const productSortSelect = productOfferFilterForm.querySelector('select[name="productSort"]');

        function buildProductQueryParams(resetPage = false) {
            const params = new URLSearchParams();
            params.set('activeTab', 'productOffers'); // Always send the active tab

            if (productSearchInput.value) params.set('productSearch', productSearchInput.value);
            if (productStartDateInput.value) params.set('productStartDate', productStartDateInput.value);
            if (productEndDateInput.value) params.set('productEndDate', productEndDateInput.value);
            if (productSortSelect.value) params.set('productSort', productSortSelect.value);

            const existingParams = new URLSearchParams(window.location.search);
            if (!resetPage && existingParams.has('productPage')) {
                params.set('productPage', existingParams.get('productPage'));
            }

            return params.toString();
        }

        productOfferFilterForm.addEventListener('submit', function(event) {
            event.preventDefault();
            window.location.href = `/admin/offers?${buildProductQueryParams(true)}`;
        });

        productStartDateInput.addEventListener('change', function() {
            productOfferFilterForm.submit();
        });
        productEndDateInput.addEventListener('change', function() {
            productOfferFilterForm.submit();
        });

        // --- Category Offer Filter Form Logic ---
        const categoryOfferFilterForm = document.getElementById('categoryOfferFilterForm');
        const categorySearchInput = categoryOfferFilterForm.querySelector('input[name="categorySearch"]');
        const categoryStartDateInput = categoryOfferFilterForm.querySelector('input[name="categoryStartDate"]');
        const categoryEndDateInput = categoryOfferFilterForm.querySelector('input[name="categoryEndDate"]');
        const categorySortSelect = categoryOfferFilterForm.querySelector('select[name="categorySort"]');

        function buildCategoryQueryParams(resetPage = false) {
            const params = new URLSearchParams();
            params.set('activeTab', 'categoryOffers'); // Always send the active tab

            if (categorySearchInput.value) params.set('categorySearch', categorySearchInput.value);
            if (categoryStartDateInput.value) params.set('categoryStartDate', categoryStartDateInput.value);
            if (categoryEndDateInput.value) params.set('categoryEndDate', categoryEndDateInput.value);
            if (categorySortSelect.value) params.set('categorySort', categorySortSelect.value);

            const existingParams = new URLSearchParams(window.location.search);
            if (!resetPage && existingParams.has('categoryPage')) {
                params.set('categoryPage', existingParams.get('categoryPage'));
            }

            return params.toString();
        }

        categoryOfferFilterForm.addEventListener('submit', function(event) {
            event.preventDefault();
            window.location.href = `/admin/offers?${buildCategoryQueryParams(true)}`;
        });

        categoryStartDateInput.addEventListener('change', function() {
            categoryOfferFilterForm.submit();
        });
        categoryEndDateInput.addEventListener('change', function() {
            categoryOfferFilterForm.submit();
        });

        // --- Tab Management (Optional but good for UX) ---
        // This ensures the correct tab is visible if you later add Bootstrap tabs
        const urlParams = new URLSearchParams(window.location.search);
        const activeTab = urlParams.get('activeTab');
        if (activeTab === 'categoryOffers') {
            // Logic to activate category offers tab/section
            // For now, since there are no actual tabs, this just logs
            console.log('Category Offers tab should be active');
        } else {
            console.log('Product Offers tab should be active');
        }

    });

