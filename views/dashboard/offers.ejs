    <div class="card mb-4">
        <header class="card-header">
            <h4 class="card-title mb-4">Product Offers</h4>
            <div class="row gx-3">
                <div class="col-lg-12">
                    <form action="/admin/offers" method="GET" id="productOfferFilterForm" class="row gx-3 align-items-center">
                        <input type="hidden" name="activeTab" value="productOffers"> <div class="col-lg-4 col-md-6 mb-lg-0 mb-1">
                            <div class="input-group">
                                <input type="text" placeholder="Search Offer Name / Product Name" class="form-control" name="productSearch" value="<%= typeof productSearch !== 'undefined' ? productSearch : '' %>">
                                <button class="btn btn-light bg-primary text-white" type="submit">Search</button>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-lg-0 mb-1">
                            <div class="input-group">
                                <span class="input-group-text">Start Date</span>
                                <input type="date" class="form-control" name="productStartDate" value="<%= typeof productStartDate !== 'undefined' ? productStartDate : '' %>">
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-lg-0 mb-1">
                            <div class="input-group">
                                <span class="input-group-text">End Date</span>
                                <input type="date" class="form-control" name="productEndDate" value="<%= typeof productEndDate !== 'undefined' ? productEndDate : '' %>">
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-6 mb-lg-0 mb-1">
                            <select class="form-select" name="productSort" onchange="document.getElementById('productOfferFilterForm').submit()">
                                <option value="newest" <%= typeof productSort !== 'undefined' && productSort === 'newest' ? 'selected' : '' %>>Newest First</option>
                                <option value="oldest" <%= typeof productSort !== 'undefined' && productSort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                                <option value="startDateAsc" <%= typeof productSort !== 'undefined' && productSort === 'startDateAsc' ? 'selected' : '' %>>Start Date Asc</option>
                                <option value="endDateAsc" <%= typeof productSort !== 'undefined' && productSort === 'endDateAsc' ? 'selected' : '' %>>End Date Asc</option>
                            </select>
                        </div>
                    </form>
                </div>
            </div>
        </header>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Offer Name</th>
                            <th>Product Name</th>
                            <th>Discount Type</th>
                            <th>Discounted Value</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th>Action</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (offers && offers.length > 0) { %>
                            <% offers.forEach(function(offer) { %>
                                <tr>
                                    <td><%= offer.offerName %></td>
                                    <td><%= offer.productName ? offer.productName.name : 'N/A' %></td>
                                    <td><%= offer.discountType %></td>
                                    <td><%= offer.discountValue %></td>
                                    <td><%= new Date(offer.startDate).toLocaleDateString() %></td>
                                    <td><%= new Date(offer.endDate).toLocaleDateString() %></td>
                                    <td><%= offer.isActive ? 'Active' : 'Inactive' %></td>
                                    <td>
                                        <% if(offer.isActive) {%>
    <button class="btn btn-primary btn-sm" onclick="isactive(`<%= offer._id %>`)">Deactivate</button>
<%} else {%>
    <button class="btn btn-primary btn-sm" onclick="isactive(`<%= offer._id %>`)">Activate</button>
<%}%>

                                    </td>
                                    <td>
                                        <button class="btn btn-danger btn-sm" onclick="productdelete(`<%= offer._id %>`)">Delete</button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="9">No Product Offers found matching your criteria.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="pagination-area mt-30 mb-50 px-3">
            <nav aria-label="Product Offer Pagination">
                <ul class="pagination justify-content-start">
                    <li class="page-item <%= productCurrentPage === 1 ? 'disabled' : '' %>">
                        <a class="page-link" href="?<%= new URLSearchParams({...productQueryParams, productPage: productCurrentPage - 1}).toString() %>">P</a>
                    </li>
                    <% for(let i = 1; i <= productTotalPages; i++) { %>
                        <li class="page-item <%= productCurrentPage === i ? 'active' : '' %>">
                            <a class="page-link" href="?<%= new URLSearchParams({...productQueryParams, productPage: i}).toString() %>"><%= i %></a>
                        </li>
                    <% } %>
                    <li class="page-item <%= productCurrentPage === productTotalPages ? 'disabled' : '' %>">
                        <a class="page-link" href="?<%= new URLSearchParams({...productQueryParams, productPage: productCurrentPage + 1}).toString() %>">N</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

