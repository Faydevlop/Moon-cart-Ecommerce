<div class="card mb-4">
    <form id="couponForm" method="post" action="/admin/coupenpost">
        <header class="card-header">
            <!-- Any content you want in the header -->
            <% if(locals.done) { %>
                <p style="color: green;"><%= done %></p>
            <% } %>
            <% if(locals.error) { %>
                <p><%= error %></p>
            <% } %>
        </header>
        <div class="card-body">
            <div class="form-row">
                <div class="col-md-6 mb-3">
                    <label for="couponCode">Coupon Code</label>
                    <input class="form-control" name="couponCode" id="couponCode" placeholder="Enter coupon code">
                    <span id="couponCodeError" class="text-danger"></span>
                </div>
                <div class="col-lg-12 col-md-12 col-12">
                    <button class="btn btn-primary" type="button" onclick="generateCouponCode()">Generate Coupon Code</button>
                </div>
            </div>
            <hr>
            <div class="form-row">
                <div class="col-md-6 mb-3">
                    <label for="discripetion">Discription</label>
                    <input type="text" name="discripetion" class="form-control" id="discripetion" placeholder="Discription">
                    <span id="discripetionError" class="text-danger"></span>
                </div>
            </div>
            <div class="form-row">
                <div class="col-md-6 mb-3">
                    <label for="discountPercentage">Discount Percentage</label>
                    <input type="number" name="discountPercentage" class="form-control" id="discountPercentage" placeholder="Enter discount percentage">
                    <span id="discountPercentageError" class="text-danger"></span>
                </div>
            </div>
            <div class="form-row">
                <div class="col-md-6 mb-3">
                    <label for="maxDiscountAmount">Max Discount Amount</label>
                    <input type="number" name="maxdiscountamount" class="form-control" id="maxDiscountAmount" placeholder="Enter max discount amount">
                    <span id="maxDiscountAmountError" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="minAmount">Min Amount</label>
                    <input type="number" name="minamount" class="form-control" id="minAmount" placeholder="Enter min amount">
                    <span id="minAmountError" class="text-danger"></span>
                </div>
            </div>
            <div class="form-row">
                <div class="col-md-6 mb-3">
                    <label for="maxAmount">Max Amount</label>
                    <input type="number" name="maxamount" class="form-control" id="maxAmount" placeholder="Enter max amount">
                    <span id="maxAmountError" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="expiryDate">Expiry Date</label>
                    <input type="date" name="date" class="form-control" id="expiryDate" placeholder="Enter expiry date">
                    <span id="expiryDateError" class="text-danger"></span>
                </div>
            </div>
            <hr>
            <div class="form-row">
                <div class="col-lg-12 col-md-12 col-12">
                    <button class="btn btn-primary" type="button" onclick="validateForm()">Create Coupon</button>
                </div>
            </div>
        </div>
    </form>
</div>
            
        
