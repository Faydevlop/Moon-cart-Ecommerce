          <section class="content-main">
    <div class="card mb-4">
        <header class="card-header">
            <div class="row gx-3">
                <div class="col-lg-4 col-md-6 mb-lg-0 mb-1">
                    <form action="/admin/referalcode" method="GET" id="couponFilterForm">
                        <div class="input-group">
                            <input type="text" placeholder="Search by Coupon Code or Description" class="form-control" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>">
                            <button class="btn btn-light bg-primary text-white" type="submit">Search</button>
                        </div>
                    </form>
                </div>
                <div class="col-lg-2 col-md-3 col-6 mb-lg-0 mb-1">
                    <form action="/admin/referalcode" method="GET" id="statusFilterForm">
                        <select class="form-select" name="status" onchange="document.getElementById('statusFilterForm').submit()">
                            <option value="">All Statuses</option>
                            <option value="Active" <%= typeof status !== 'undefined' && status === 'Active' ? 'selected' : '' %>>Active</option>
                            <option value="Disabled" <%= typeof status !== 'undefined' && status === 'Disabled' ? 'selected' : '' %>>Disabled</option>
                        </select>
                    </form>
                </div>
                <div class="col-lg-4 col-md-6 mb-lg-0 mb-1">
                    <form action="/admin/referalcode" method="GET" id="dateFilterForm">
                        <div class="input-group">
                            <input type="date" class="form-control" name="startDate" value="<%= typeof startDate !== 'undefined' ? startDate : '' %>">
                            <input type="date" class="form-control" name="endDate" value="<%= typeof endDate !== 'undefined' ? endDate : '' %>">
                            <button class="btn btn-light bg-primary text-white" type="submit">Filter by Expiry Date</button>
                        </div>
                    </form>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <form action="/admin/referalcode" method="GET" id="paginationSortForm">
                        <select class="form-select" name="limit" onchange="document.getElementById('paginationSortForm').submit()">
                            <option value="10" <%= typeof limit !== 'undefined' && limit == 10 ? 'selected' : '' %>>Show 10</option>
                            <option value="20" <%= typeof limit !== 'undefined' && limit == 20 ? 'selected' : '' %>>Show 20</option>
                            <option value="30" <%= typeof limit !== 'undefined' && limit == 30 ? 'selected' : '' %>>Show 30</option>
                            <option value="40" <%= typeof limit !== 'undefined' && limit == 40 ? 'selected' : '' %>>Show 40</option>
                        </select>
                        <select class="form-select mt-2" name="sort" onchange="document.getElementById('paginationSortForm').submit()">
                            <option value="newest" <%= typeof sort !== 'undefined' && sort === 'newest' ? 'selected' : '' %>>Newest First</option>
                            <option value="oldest" <%= typeof sort !== 'undefined' && sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                            <option value="expiryAsc" <%= typeof sort !== 'undefined' && sort === 'expiryAsc' ? 'selected' : '' %>>Expiry Soonest</option>
                            <option value="expiryDesc" <%= typeof sort !== 'undefined' && sort === 'expiryDesc' ? 'selected' : '' %>>Expiry Latest</option>
                        </select>
                    </form>
                </div>
            </div>
        </header>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Coupon</th>
                            <th>Description</th>
                            <th>Discount Percentage</th>
                            <th>Max Discount Amount</th>
                            <th>Min Amount</th>
                            <th>Max Amount</th>
                            <th>Expiry Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data && data.length > 0) { %>
                            <% data.forEach(coupon => { %>
                                <tr>
                                    <td><%= coupon.couponCode %></td>
                                    <td><%= coupon.discripetion %></td>
                                    <td>%<%= coupon.discountPercentage %></td>
                                    <td>₹ <%= coupon.maxDiscountAmount %></td>
                                    <td>₹ <%= coupon.minAmount %></td>
                                    <td>₹ <%= coupon.maxAmount %></td>
                                    <td><%= new Date(coupon.expiryDate).toISOString().slice(0, 10) %></td>
                                    <td>
                                        <% if (coupon.Status === 'Active') { %>
                                            <span class="badge rounded-pill alert-success">Active</span>
                                        
                                        <% } else { %>
                                            <span class="badge rounded-pill alert-secondary">expired</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if(coupon.isListed) {%>
                                            <button class="btn btn-primary btn-sm" onclick="listitem(`<%= coupon._id %>`)" >Unlist</button>
                                        <%} else {%>
                                            <button class="btn btn-primary btn-sm" onclick="listitem(`<%= coupon._id %>`)" >List</button>
                                        <%}%>
                                        <a href="/admin/editcop/<%= coupon._id %>" class="btn btn-secondary btn-sm" id="editButton">Edit</a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="9">No coupons found matching your criteria.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div> </div> </div>

