    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Get all filter elements
        const searchInput = document.querySelector('input[name="search"]');
        const statusSelect = document.querySelector('select[name="status"]');
        const startDateInput = document.querySelector('input[name="startDate"]');
        const endDateInput = document.querySelector('input[name="endDate"]');
        const limitSelect = document.querySelector('select[name="limit"]');
        const sortSelect = document.querySelector('select[name="sort"]');

        // Function to build query parameters from all active filters
        function buildQueryParams(resetPage = false) {
            const newParams = new URLSearchParams();

            if (searchInput.value) newParams.set('search', searchInput.value);
            if (statusSelect.value) newParams.set('status', statusSelect.value);
            if (startDateInput.value) newParams.set('startDate', startDateInput.value);
            if (endDateInput.value) newParams.set('endDate', endDateInput.value);
            if (limitSelect.value) newParams.set('limit', limitSelect.value);
            if (sortSelect.value) newParams.set('sort', sortSelect.value);

            // Preserve current page unless resetPage is true
            const existingParams = new URLSearchParams(window.location.search);
            if (!resetPage && existingParams.has('page')) {
                newParams.set('page', existingParams.get('page'));
            }

            return newParams.toString();
        }

        // Event listeners for form submissions
        document.getElementById('couponFilterForm').addEventListener('submit', function(event) {
            event.preventDefault(); // Prevent default form submission
            window.location.href = `/admin/referalcode?${buildQueryParams(true)}`; // Reset page on new search
        });

        document.getElementById('dateFilterForm').addEventListener('submit', function(event) {
            event.preventDefault(); // Prevent default form submission
            window.location.href = `/admin/referalcode?${buildQueryParams(true)}`; // Reset page on new date filter
        });
        
        // Use onchange for select elements for simplicity, ensure they trigger combined query
        statusSelect.addEventListener('change', function() {
            window.location.href = `/admin/referalcode?${buildQueryParams(true)}`; // Reset page on new status filter
        });

        limitSelect.addEventListener('change', function() {
            window.location.href = `/admin/referalcode?${buildQueryParams(true)}`; // Reset page on limit change
        });

        sortSelect.addEventListener('change', function() {
            window.location.href = `/admin/referalcode?${buildQueryParams(true)}`; // Reset page on sort change
        });
    });
</script>
