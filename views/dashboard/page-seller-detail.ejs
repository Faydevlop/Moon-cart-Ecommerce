        <div class="container">
            <h1>Users List</h1>
            <form method="get" action="/admin/page-seller-detail" class="mb-4">
  <input type="text" name="search" placeholder="Search by name/email/mobile" class="form-control mb-2">

  <select name="status" class="form-select mb-2">
    <option value="">All</option>
    <option value="active">Active</option>
    <option value="blocked">Blocked</option>
  </select>

  <div class="row mb-2">
    <div class="col">
      <input type="date" name="startDate" class="form-control">
    </div>
    <div class="col">
      <input type="date" name="endDate" class="form-control">
    </div>
  </div>

  <button type="submit" class="btn btn-primary">Filter</button>
</form>

            <table class="table">
              <thead>
                <tr>
                  <th>Username</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% user.forEach(user => { %>
                  <tr>
                    <td><%= user.Username %></td>
                    <td><%= user.email %></td>
                    <td>+<%= user.Mobile %></td>
                    <td>
                      <% if (user.isBlocked) { %>
                        <span class="badge badge-danger" style="color: #dc3545;">Blocked</span>
                      <% } else { %>
                        <span class="badge badge-success" style="color: green;">Active</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (!user.isBlocked) { %>
                        <form action="/admin/block-user/<%= user._id %>" method="post">
                          <button type="submit" class="btn btn-block btn-block-user">Block User</button>
                          
                        </form>
                        
                      <% } else { %>
                        <form action="/admin/unblock-user/<%= user._id %>" method="post">
                            <button type="submit" class="btn btn-block btn-block-user">UnBlock User</button>
                            
                          </form>
                        <!-- You may want to add an "Unblock User" button here -->
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
            <nav>
  <ul class="pagination">
    <% for(let i = 1; i <= totalPages; i++) { %>
      <li class="page-item <%= currentPage === i ? 'active' : '' %>">
        <a class="page-link" href="?page=<%= i %>"><%= i %></a>
      </li>
    <% } %>
  </ul>
</nav>
